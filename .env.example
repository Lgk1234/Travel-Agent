# ============================================================
# 智能出行助手 - 环境变量模板
# 复制本文件为 .env 并填入真实密钥：cp .env.example .env
# ============================================================

# ---- 默认大模型（统一走阿里云百炼，仅改模型名即可切换）----
# 可选: qwen3.8-flash / qwen-max / deepseek-chat 等任意百炼模型
DEFAULT_MODEL=qwen-max

# ---- 大模型（统一走阿里云百炼 OpenAI 兼容网关，仅改模型名即可切换）----
LLM_API_KEY=
LLM_BASE_URL=https://<workspace>.maas.aliyuncs.com/compatible-mode/v1

# ---- 高德地图 MCP（必填，提供真实 POI / 路线数据）----
AMAP_API_KEY=

# ---- 和风天气（自定义 tool 接入，GeoAPI，提供精细化天气/生活指数）----
# 免费申请：https://console.qweather.com
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# ---- LangSmith 可观测性（可选）----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=smart-travel-agent
